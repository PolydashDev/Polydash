# Polypad web app — copy to .env and fill in

# Deployed contracts (Robinhood Chain mainnet)
NEXT_PUBLIC_FACTORY_ADDRESS=0x2C84cFCD8d283EF750E09Fbed735d67F67845dB2
NEXT_PUBLIC_COMMIT_VAULT_ADDRESS=0x8F125c9eC7acD52B9cd39f2a7441085559d84104

# Chain
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Optional: WalletConnect project ID (https://cloud.reown.com). Without it, injected + deep-link wallets still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Public site URL (used for social preview metadata)
NEXTAUTH_URL=http://localhost:3000

# Token logo uploads (S3). Credentials come from the standard AWS chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or AWS_PROFILE). The bucket must allow
# public reads and browser PUTs (CORS) from your site's origin.
AWS_REGION=us-east-1
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=polypad/
